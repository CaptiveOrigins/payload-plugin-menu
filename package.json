{
  "name": "@captiveorigins/payload-plugin-menu",
  "version": "0.1.0",
  "description": "Menus for Payload: drag-and-drop links, dropdowns and section headings, optional icons or emoji, alphabetical order in each visitor’s language, and visibility per entry.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-menu#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-menu/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "menu",
    "navigation",
    "nav",
    "header",
    "multi-tenant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-menu.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.80.0",
    "payload": "^3.80.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.92.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "next": "16.3.3",
    "payload": "3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
